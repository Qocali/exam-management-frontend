# Staging mühiti — bu faylı .env.staging adı ilə kopyalayın və dəyərləri öz serverlərinizə uyğun dəyişin:
#   cp .env.staging.example .env.staging
#   docker compose --env-file .env.staging -p exam-staging up -d --build
#
# .env.staging git-ə düşmür (.gitignore). Bu nümunə faylda secret yoxdur və olmamalıdır.

# Staging build: optimizasiya + source map, səhifənin yuxarısında "SINAQ MÜHİTİ" zolağı
BUILD_CONFIGURATION=staging

# Shell konteynerinin /api sorğularını yönləndirdiyi backend (ASPNETCORE_ENVIRONMENT=Staging)
API_UPSTREAM=https://api.staging.example.com

# Brauzerin remote-ları yüklədiyi ünvanlar (federation.manifest.json konteyner açılarkən bunlardan yaradılır)
MFE_LESSONS_URL=https://lessons.staging.example.com
MFE_STUDENTS_URL=https://students.staging.example.com
MFE_EXAMS_URL=https://exams.staging.example.com
MFE_TESTS_URL=https://tests.staging.example.com

# Host portları — production ilə eyni serverdə işləyəcəksə fərqli olmalıdır
SHELL_PORT=9080
MFE_LESSONS_PORT=9081
MFE_STUDENTS_PORT=9082
MFE_EXAMS_PORT=9083
MFE_TESTS_PORT=9084
