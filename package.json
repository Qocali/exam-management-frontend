{
  "name": "exam-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "İmtahan proqramı — Angular micro frontend (Native Federation)",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n shell,lessons,students,exams -c blue,green,magenta,cyan \"npm:start:shell\" \"npm:start:lessons\" \"npm:start:students\" \"npm:start:exams\"",
    "start:shell": "ng serve shell",
    "start:lessons": "ng serve mfe-lessons",
    "start:students": "ng serve mfe-students",
    "start:exams": "ng serve mfe-exams",
    "build": "ng build shell && ng build mfe-lessons && ng build mfe-students && ng build mfe-exams",
    "build:staging": "ng build shell -c staging && ng build mfe-lessons -c staging && ng build mfe-students -c staging && ng build mfe-exams -c staging",
    "test": "ng test shared --watch=false"
  },
  "dependencies": {
    "@angular-architects/native-federation": "^20.0.0",
    "@angular/cdk": "^20.2.0",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "es-module-shims": "^1.10.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.0",
    "@angular/cli": "^20.3.0",
    "@angular/compiler-cli": "^20.3.0",
    "@types/jasmine": "~5.1.0",
    "concurrently": "^9.1.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "typescript": "~5.8.3"
  }
}
