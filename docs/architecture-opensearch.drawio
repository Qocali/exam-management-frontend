        <mxCell id="e-infra-db" value="&lt;b&gt;EF Core&lt;/b&gt;&lt;br&gt;① entity + Outbox&lt;br&gt;(bir tranzaksiya)&lt;br&gt;Ⓒ WHERE Id IN (…)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;startArrow=block;strokeWidth=3;strokeColor=#666666;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="infra" target="db">
