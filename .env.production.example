# Production mühiti — bu faylı .env.production adı ilə kopyalayın və dəyərləri doldurun:
#   cp .env.production.example .env.production
#   docker compose --env-file .env.production -p exam-production up -d --build
#
# .env.production git-ə düşmür (.gitignore). Bu nümunə faylda secret yoxdur və olmamalıdır.

# Production build: tam optimizasiya, source map yoxdur, mühit zolağı yoxdur
BUILD_CONFIGURATION=production

# Shell konteynerinin /api sorğularını yönləndirdiyi backend (ASPNETCORE_ENVIRONMENT=Production)
API_UPSTREAM=https://api.example.com

# Brauzerin remote-ları yüklədiyi ünvanlar
MFE_LESSONS_URL=https://lessons.example.com
MFE_STUDENTS_URL=https://students.example.com
MFE_EXAMS_URL=https://exams.example.com

SHELL_PORT=8080
MFE_LESSONS_PORT=8081
MFE_STUDENTS_PORT=8082
MFE_EXAMS_PORT=8083
